{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K-Shell",
  "version": "0.1.0",
  "identifier": "dev.keselyoleren.kshell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "K-Shell",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "SSH, SFTP, FTP & S3 client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNTgzMjJBMTg2NDA2QUMKUldTc0JtUVlLakpZM0hKN1crMlMzR3cwR1MrMEhkdDBzUE54TWk4WnBiUTc2VERWQ0o5QzBEQXIK",
      "endpoints": [
        "https://github.com/keselyoleren/ssh_client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
